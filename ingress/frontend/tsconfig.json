{
  "compilerOptions": {
    "target": "ES6", 
    "lib": ["dom", "dom.iterable", "esnext"], 
    "strict": true,  
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx", 
    "moduleResolution": "node", 
    "resolveJsonModule": true, 
    "allowJs": true,
    "noEmit": true, 
    "skipLibCheck": true, 
    "esModuleInterop": true, 
    "isolatedModules": true, 
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "build"]
}
